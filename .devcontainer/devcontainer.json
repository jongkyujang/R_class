{
  "name": "R Class",
  "hostRequirements": {
    "cpus": 4
  },
  "build": {
    "dockerfile": "Dockerfile"
  },
  "overrideCommand": true,
  "remoteUser": "rstudio",
  "postStartCommand": "rserver --server-daemonize=1",  
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "RStudio",
      "onAutoForward": "openBrowser"
    }
  }
}
