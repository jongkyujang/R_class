{
  "name": "R Class",
  "hostRequirements": {
    "cpus": 4
  },
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "rstudio",
  "postStartCommand": "sudo rserver --auth-none=1 --auth-minimum-user-id=1000",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "RStudio",
      "onAutoForward": "openBrowser"
    }
  }
}
